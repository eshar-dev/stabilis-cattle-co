---
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import logo from '../../assets/brand/stabilis-logo.png';
import { nav } from '../../data/store';
---

<header class="nav" data-nav>
  <nav class="nav__bar" aria-label="Main">
    <div class="nav__side">
      <ul class="nav__links">
        {nav.left.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
      <button class="btn btn--secondary btn--sm nav__menu" type="button" data-menu-toggle aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
        <Icon name="menu-2" class="nav__menu-open" />
        <Icon name="x" class="nav__menu-close" />
        Menu
      </button>
    </div>
    <a href="#top" class="nav__logo" aria-label="Stabilis Cattle Company home">
      <Image src={logo} alt="Stabilis Cattle Company" height={120} loading="eager" />
    </a>
    <div class="nav__side nav__side--end">
      <ul class="nav__links">
        {nav.right.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
      <button class="btn btn--primary btn--sm nav__cart" type="button" data-cart-open aria-label="Open cart">
        <Icon name="shopping-bag" />
        Cart
        <span class="nav__badge" data-cart-badge>0</span>
      </button>
    </div>
  </nav>
  <div class="mmenu" id="mobile-menu" data-menu hidden>
    <ul>
      {nav.all.map((l) => <li><a href={l.href} data-menu-link>{l.label}</a></li>)}
    </ul>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--nav-h);
    background: rgb(255 255 255 / 0.96);
    border-bottom: 1px solid transparent;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: border-color 300ms ease;
  }
  .nav.is-scrolled {
    border-bottom-color: rgb(31 33 29 / 0.08);
  }
  .nav__bar {
    height: 100%;
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 24px;
  }
  .nav__side {
    display: flex;
    gap: 36px;
    align-items: center;
    font-family: var(--f-display);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .nav__side--end {
    justify-content: flex-end;
  }
  .nav__links {
    display: none;
    gap: 36px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav__links a {
    display: inline-flex;
    align-items: center;
    height: 32px;
    position: relative;
    color: inherit;
  }
  .nav__links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 2px;
    background: var(--c-gold);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 280ms var(--ease-out);
  }
  .nav__links a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .nav__links a:hover {
    color: inherit;
  }
  .nav__logo {
    display: block;
  }
  .nav__logo :global(img) {
    height: clamp(46px, 4.4vw, 60px);
    width: auto;
  }
  .nav__menu-close {
    display: none;
  }
  .nav__menu[aria-expanded='true'] .nav__menu-open {
    display: none;
  }
  .nav__menu[aria-expanded='true'] .nav__menu-close {
    display: inline-block;
  }
  .nav__cart {
    padding: 0 6px 0 16px;
    font-size: 14px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .nav__menu {
    padding: 0 14px 0 12px;
    font-size: 14px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .nav__badge {
    min-width: 32px;
    height: 32px;
    border-radius: 6px;
    background: var(--c-green-900);
    color: var(--c-cream);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0;
    padding: 0 8px;
  }
  .mmenu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--c-white);
    border-bottom: 1px solid var(--c-hairline);
    box-shadow: 0 24px 48px rgb(19 46 32 / 0.12);
    padding: 8px var(--gutter) 28px;
  }
  .mmenu[hidden] {
    display: none;
  }
  .mmenu ul {
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 26px;
  }
  .mmenu li + li {
    border-top: 1px solid var(--c-hairline);
  }
  .mmenu a {
    display: block;
    padding: 14px 0;
  }
  @media (min-width: 1140px) {
    .nav__links {
      display: flex;
    }
    .nav__menu,
    .mmenu {
      display: none !important;
    }
  }
</style>



