---
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import { cuts, openBreed, photo } from '../../data/store';

const totalLeft = cuts.reduce((a, c) => a + c.left, 0);
---

<section id="open-now" class="open" data-hsection>
  <div class="open__inner">
    <div class="open__intro" data-hintro>
      <div class="stack" style="gap:22px">
        <div class="kicker">Open right now</div>
        <h2 class="h2">Order beef online from the animal that is open now</h2>
      </div>
      <p class="lede" style="font-size:17px;line-height:1.7">
        Each animal we raise is its own small batch, so what you see here is the whole menu. You can order beef online by the cut: browse, choose what suits your table, and we will take care of the rest. It might be a couple of steaks for the weekend or enough to fill the freezer. Either way, it is the same care.
      </p>
    </div>

    <div class="open__stage" data-hstage>
      <div class="open__bar">
        <div class="open__who">
          <Image src={photo('photo-1618539640243-a9e6572a7fe7')} alt={`${openBreed} animal currently open for orders`} width={104} height={104} class="open__avatar" />
          <div class="stack" style="gap:2px">
            <span class="open__label">Breed of this animal</span>
            <span class="open__breed"><strong>{openBreed}</strong><span>{totalLeft} cuts across {cuts.length} types</span></span>
          </div>
        </div>
        <div class="open__scroll">
          <span>Scroll the cuts</span>
          <span class="open__track"><span class="open__fill" data-hprogress></span></span>
        </div>
      </div>

      <div class="open__viewport" data-hviewport tabindex="0" aria-label="Available cuts">
        <ul class="open__rail" data-htrack>
          {
            cuts.map((c) => (
              <li class="cut" data-cut-card data-id={c.id} data-price={c.price} data-left={c.left} data-name={c.name}>
                <div class="cut__media">
                  <Image src={photo(c.img)} alt={c.alt} widths={[400, 700]} sizes="300px" class="cut__img" data-cut-img />
                  <span class="cut__badge" data-cut-badge></span>
                </div>
                <div class="cut__body">
                  <div class="cut__row">
                    <h3>{c.name}</h3>
                    <span class="cut__price">${c.price}</span>
                  </div>
                  <p>{c.spec}</p>
                  <div class="cut__spacer" />
                  <button class="btn btn--primary btn--block" type="button" data-add aria-label={`Add ${c.name} to cart, $${c.price}`}>
                    <Icon name="plus" />Add to cart
                  </button>
                  <div class="cut__qty" data-qty hidden>
                    <div class="cut__stepper" role="group" aria-label={`${c.name} quantity`}>
                      <button type="button" data-dec aria-label="Remove one"><Icon name="minus" data-dec-icon /></button>
                      <span aria-live="polite" data-qty-label />
                      <button type="button" data-inc aria-label="Add one"><Icon name="plus" /></button>
                    </div>
                    <button type="button" class="btn btn--secondary btn--block btn--sm cut__view" data-cart-open>
                      <span class="cut__total" data-line-total /><span class="cut__go">View cart<Icon name="arrow-right" size={14} /></span>
                    </button>
                  </div>
                </div>
              </li>
            ))
          }
          <li class="open__end">
            <p>Ordering closes once every cut is spoken for.</p>
            <button class="btn btn--primary" type="button" data-cart-open>Choose your cuts<Icon name="arrow-right" /></button>
            <small>Cut list, prices and counts shown are sample data. Live values come from the Shopify block.</small>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .open {
    position: relative;
    background: var(--c-white);
    overflow: hidden;
  }
  .open__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(48px, 8vh, 88px);
    padding: clamp(88px, 12vh, 136px) 0 clamp(72px, 10vh, 112px);
  }
  .open__intro {
    width: 100%;
    max-width: calc(var(--max-w) + 2 * var(--gutter));
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
    gap: 28px clamp(40px, 6vw, 96px);
    align-items: end;
  }
  .open__stage {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .open__bar {
    width: 100%;
    max-width: calc(var(--max-w) + 2 * var(--gutter));
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 40px;
  }
  .open__who {
    display: flex;
    gap: 14px;
    align-items: center;
  }
  .open__who :global(.open__avatar) {
    width: 52px;
    height: 52px;
    object-fit: cover;
    border-radius: 50%;
    border: 2px solid var(--c-gold);
  }
  .open__label {
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--c-green-600);
  }
  .open__breed {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }
  .open__breed strong {
    font-family: var(--f-display);
    font-size: 24px;
    line-height: 1.1;
  }
  .open__breed span {
    font-size: 14px;
    color: var(--c-ink-mute);
  }
  .open__scroll {
    flex: 0 1 340px;
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--c-ink-mute);
  }
  .open__scroll > span:first-child {
    white-space: nowrap;
  }
  .open__track {
    position: relative;
    flex: 1;
    height: 2px;
    background: rgb(31 33 29 / 0.16);
    overflow: hidden;
  }
  .open__fill {
    position: absolute;
    inset: 0;
    background: var(--c-gold);
    transform-origin: left;
    transform: scaleX(0.08);
  }
  .open__viewport {
    min-width: 0;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scroll-padding-left: calc(max(0px, (100% - var(--max-w)) / 2) + var(--gutter));
  }
  .open__viewport::-webkit-scrollbar {
    display: none;
  }
  .open__rail {
    display: flex;
    align-items: stretch;
    gap: clamp(20px, 2vw, 32px);
    width: max-content;
    margin: 0;
    list-style: none;
    padding: 8px clamp(32px, 8vw, 160px) 8px calc(max(0px, (100vw - var(--max-w)) / 2) + var(--gutter));
  }
  .cut {
    width: min(78vw, 300px);
    flex: none;
    display: flex;
    flex-direction: column;
    background: var(--c-cream);
    border-radius: var(--r-lg);
    overflow: hidden;
    scroll-snap-align: start;
  }
  .cut__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--c-green-800);
  }
  .cut__media :global(.cut__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease-out);
  }
  .cut:hover .cut__media :global(.cut__img) {
    transform: scale(1.05);
  }
  .cut__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: var(--c-green-900);
    color: var(--c-cream);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 6px 10px;
    border-radius: var(--r-sm);
  }
  .cut[data-low] .cut__badge {
    background: var(--c-red);
  }
  .cut__body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }
  .cut__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }
  .cut__row h3 {
    margin: 0;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 24px;
    line-height: 1.15;
  }
  .cut__price {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: 22px;
    line-height: 1.15;
  }
  .cut__body p {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--c-ink-mute);
  }
  .cut__spacer {
    flex: 1;
    min-height: 16px;
  }
  .cut__qty {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .cut__qty[hidden],
  [data-add][hidden] {
    display: none;
  }
  .cut__stepper {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) 40px;
    align-items: center;
    gap: 4px;
    height: 52px;
    padding: 0 6px;
    border-radius: var(--r-md);
    background: var(--c-green-900);
    color: var(--c-cream);
  }
  .cut__stepper button {
    width: 40px;
    height: 40px;
    justify-self: center;
    border: none;
    border-radius: 50%;
    background: rgb(246 240 222 / 0.14);
    color: var(--c-cream);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition:
      background-color 200ms ease,
      color 200ms ease,
      transform 160ms var(--ease-out);
  }
  .cut__stepper button:hover {
    background: var(--c-gold);
    color: var(--c-green-900);
  }
  .cut__stepper button:active {
    transform: scale(0.88);
  }
  .cut__stepper button:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }
  .cut__stepper span {
    text-align: center;
    font-family: var(--f-display);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .cut__view {
    justify-content: space-between;
    padding: 0 16px;
    font-size: 14px;
  }
  .cut__total {
    font-weight: 700;
  }
  .cut__go {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .open__end {
    width: min(80vw, 360px);
    flex: none;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 28px;
    padding: 0 clamp(8px, 2vw, 32px);
    scroll-snap-align: start;
  }
  .open__end p {
    margin: 0;
    font-family: var(--f-display);
    font-weight: 600;
    font-size: clamp(26px, 2.4vw, 34px);
    line-height: 1.2;
    text-wrap: balance;
  }
  .open__end .btn {
    align-self: flex-start;
  }
  .open__end small {
    font-size: 13px;
    line-height: 1.6;
    color: var(--c-ink-mute);
  }
</style>




