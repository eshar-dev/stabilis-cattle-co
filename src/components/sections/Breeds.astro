---
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import { breeds } from '../../data/store';
import redAngus from '../../assets/brand/breed-red-angus.png';
import wagyu from '../../assets/brand/breed-wagyu.png';
import akaushi from '../../assets/brand/breed-akaushi.png';

const imgs = { 'red-angus': redAngus, wagyu, akaushi } as const;
---

<section id="breeds" class="breeds">
  <div class="breeds__wrap">
    <div class="section-head" data-reveal>
      <div class="stack" style="gap:20px">
        <div class="kicker">The three breeds</div>
        <h2 class="h2" style="max-width:12ch">Three breeds we chose on purpose</h2>
      </div>
      <p class="lede" style="max-width:520px">
        Most beef is raised to fit a system. We started with the breeds instead, and built the ranch around three we believe in. Each one brings something a little different to the table.
      </p>
    </div>
    <div class="breeds__row" data-breed-row>
      {
        breeds.map((b) => (
          <a class="breed" href={b.href}>
            <div class="breed__top">
              <div class="breed__ill" data-breed-ill>
                <Image src={imgs[b.img as keyof typeof imgs]} alt={`${b.name} illustration`} widths={[500, 900]} sizes="(min-width: 960px) 30vw, 100vw" />
              </div>
            </div>
            <div class="breed__body">
              <h3>{b.name}</h3>
              <p>{b.desc}</p>
              <span class="breed__cta">Explore {b.name} beef<Icon name="arrow-right" size={16} /></span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .breeds {
    background: var(--c-white);
    padding: var(--section-y) var(--gutter);
  }
  .breeds__wrap {
    max-width: var(--max-w);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(48px, 7vh, 72px);
  }
  .breeds__row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
  }
  .breed {
    display: flex;
    flex-direction: column;
    color: var(--c-ink);
    border-top: 1px solid rgb(31 33 29 / 0.14);
  }
  .breed:hover {
    color: var(--c-ink);
  }
  .breed__top {
    position: relative;
    overflow: hidden;
    padding: clamp(28px, 4vh, 48px) clamp(20px, 2.4vw, 40px) 0;
  }
  .breed__ill {
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    transition: transform 500ms var(--ease-out);
  }
  .breed:hover .breed__ill {
    transform: translateY(-8px);
  }
  .breed__ill :global(img) {
    width: 100%;
    height: auto;
    transform: translateY(5.5%);
  }
  .breed__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px clamp(20px, 2.4vw, 40px) 8px;
  }
  .breed__body h3 {
    margin: 0;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 30px;
    line-height: 1.1;
  }
  .breed__body p {
    margin: 0 0 12px;
    font-size: 16px;
    line-height: 1.7;
    color: var(--c-ink-soft);
    text-wrap: pretty;
  }
  .breed__cta {
    margin-top: auto;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 48px;
    padding: 0 22px;
    border: 1.5px solid var(--c-ink);
    border-radius: var(--r-md);
    font-weight: 600;
    font-size: 15px;
    transition:
      background-color 200ms ease,
      color 200ms ease;
  }
  .breed:hover .breed__cta {
    background: var(--c-ink);
    color: var(--c-cream);
  }
</style>
