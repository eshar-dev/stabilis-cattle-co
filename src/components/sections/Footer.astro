---
import { Image } from 'astro:assets';
import logo from '../../assets/brand/stabilis-logo.png';
import { nav } from '../../data/store';
---

<footer class="foot">
  <div class="foot__wrap">
    <div class="foot__top">
      <Image src={logo} alt="Stabilis Cattle Company" height={136} />
      <ul>
        {nav.all.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
    <div class="foot__bottom">
      <span>© 2026 Stabilis Cattle Company. Delivering across Dallas and Fort Worth.</span>
      <span>Ranch to Table. Raised with Care. Produced with Purpose.</span>
    </div>
  </div>
</footer>

<style>
  .foot {
    background: var(--c-white);
    border-top: 1px solid var(--c-hairline);
    padding: 56px var(--gutter) 32px;
  }
  .foot__wrap {
    max-width: var(--max-w);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .foot__top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
  }
  .foot__top :global(img) {
    height: 68px;
    width: auto;
  }
  .foot ul {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .foot__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    font-size: 13px;
    color: var(--c-ink-mute);
    border-top: 1px solid var(--c-hairline);
    padding-top: 24px;
  }
</style>
