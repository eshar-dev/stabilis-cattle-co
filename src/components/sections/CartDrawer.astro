---
import Icon from '../ui/Icon.astro';
import { FREE_DELIVERY_AT } from '../../data/store';
---

<div class="toast" data-toast role="status" aria-live="polite">
  <div class="toast__in">
    <img data-toast-img src="" alt="" width="44" height="44" />
    <div class="toast__txt">
      <span data-toast-title></span>
      <span data-toast-free></span>
    </div>
    <button type="button" data-cart-open>View cart</button>
  </div>
</div>

<div class="scrim" data-scrim></div>
<aside class="drawer" data-drawer aria-label="Cart" aria-hidden="true" inert data-free-at={FREE_DELIVERY_AT}>
  <div class="drawer__head">
    <span>Your cuts</span>
    <button type="button" data-cart-close aria-label="Close cart"><Icon name="x" /></button>
  </div>
  <div class="drawer__free">
    <span><Icon name="truck-delivery" /><span data-free-label></span></span>
    <span class="drawer__bar"><span data-free-bar></span></span>
  </div>
  <div class="drawer__items">
    <p data-cart-empty>Nothing here yet. Pick a cut from the animal that is open now.</p>
    <ul data-cart-items></ul>
  </div>
  <div class="drawer__foot">
    <div class="drawer__sub"><span>Subtotal</span><span data-subtotal>$0</span></div>
    <button type="button" class="btn btn--primary" data-checkout>Checkout<Icon name="arrow-right" /></button>
  </div>
</aside>

<style>
  .toast {
    position: fixed;
    left: 50%;
    bottom: 24px;
    z-index: 80;
    width: min(calc(100vw - 32px), 460px);
    transform: translate(-50%, 140%);
    opacity: 0;
    pointer-events: none;
    transition:
      transform 380ms var(--ease-out),
      opacity 250ms ease;
  }
  .toast.is-on {
    transform: translate(-50%, 0);
    opacity: 1;
    pointer-events: auto;
  }
  .toast__in {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px;
    border-radius: var(--r-lg);
    background: var(--c-green-900);
    color: var(--c-cream);
    box-shadow: var(--sh-toast);
  }
  .toast img {
    width: 44px;
    height: 44px;
    border-radius: 6px;
    object-fit: cover;
    flex: none;
  }
  .toast__txt {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .toast__txt span {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .toast__txt span:first-child {
    font-size: 14.5px;
    font-weight: 600;
  }
  .toast__txt span:last-child {
    font-size: 12.5px;
    color: #bebaaa;
  }
  .toast button {
    flex: none;
    height: 44px;
    padding: 0 18px;
    border: none;
    border-radius: var(--r-md);
    background: var(--c-gold);
    color: var(--c-ink);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color 200ms ease,
      transform 160ms var(--ease-out);
  }
  .toast button:hover {
    background: var(--c-gold-hover);
  }
  .toast button:active {
    transform: scale(0.97);
  }

  .scrim {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: rgb(19 46 32 / 0.5);
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms ease;
  }
  .scrim.is-on {
    opacity: 1;
    pointer-events: auto;
  }
  .drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 100;
    width: min(440px, 100vw);
    background: var(--c-white);
    box-shadow: var(--sh-drawer);
    display: flex;
    flex-direction: column;
    transform: translateX(calc(100% + 96px));
    visibility: hidden;
    transition:
      transform 420ms var(--ease-drawer),
      visibility 0s linear 420ms;
  }
  .drawer.is-on {
    transform: translateX(0);
    visibility: visible;
    transition-delay: 0s;
  }
  .drawer__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 24px;
    border-bottom: 1px solid var(--c-hairline);
  }
  .drawer__head > span {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 26px;
  }
  .drawer__head button {
    width: 40px;
    height: 40px;
    border-radius: var(--r-md);
    border: 1.5px solid rgb(31 33 29 / 0.25);
    background: none;
    cursor: pointer;
    color: var(--c-ink);
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      border-color 200ms ease,
      transform 160ms var(--ease-out);
  }
  .drawer__head button:hover {
    border-color: var(--c-ink);
  }
  .drawer__head button:active {
    transform: scale(0.94);
  }
  .drawer__free {
    padding: 18px 24px;
    background: var(--c-cream);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .drawer__free > span:first-child {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 600;
    color: var(--c-green-600);
  }
  .drawer__bar {
    height: 4px;
    border-radius: 4px;
    background: var(--c-hairline);
    overflow: hidden;
    display: block;
  }
  .drawer__bar > span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--c-green-600);
    transition: width 400ms var(--ease-out);
  }
  .drawer__items {
    flex: 1;
    overflow-y: auto;
    padding: 4px 24px;
  }
  .drawer__items p {
    margin: 32px 0;
    font-size: 16px;
    line-height: 1.65;
    color: var(--c-ink-soft);
  }
  .drawer__items ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .drawer__items :global(li) {
    display: flex;
    gap: 14px;
    align-items: center;
    padding: 16px 0;
    border-bottom: 1px solid var(--c-hairline);
  }
  .drawer__items :global(li img) {
    width: 64px;
    height: 64px;
    object-fit: cover;
    border-radius: var(--r-sm);
    flex: none;
  }
  .drawer__items :global(.ci__info) {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .drawer__items :global(.ci__name) {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 19px;
    line-height: 1.2;
  }
  .drawer__items :global(.ci__price) {
    font-size: 13px;
    color: var(--c-ink-mute);
  }
  .drawer__items :global(.ci__qty) {
    display: flex;
    align-items: center;
    border: 1.5px solid rgb(31 33 29 / 0.2);
    border-radius: var(--r-md);
    height: 36px;
  }
  .drawer__items :global(.ci__qty button) {
    width: 34px;
    height: 100%;
    border: none;
    background: none;
    cursor: pointer;
    color: var(--c-ink);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .drawer__items :global(.ci__qty button:active) {
    transform: scale(0.9);
  }
  .drawer__items :global(.ci__qty span) {
    min-width: 22px;
    text-align: center;
    font-weight: 600;
    font-size: 15px;
  }
  .drawer__foot {
    padding: 20px 24px 24px;
    border-top: 1px solid var(--c-hairline);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .drawer__sub {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 22px;
  }
  .drawer__foot .btn {
    border: none;
  }
</style>

