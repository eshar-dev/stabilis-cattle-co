---
import { faqs } from '../../data/store';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section id="faq" class="faq">
  <div class="faq__grid">
    <div class="stack" style="gap:20px" data-reveal>
      <div class="kicker">FAQ</div>
      <h2 class="h2" style="max-width:520px">Questions people ask before their first order</h2>
    </div>
    <div class="faq__list">
      {
        faqs.map((f, i) => (
          <details name="faq" open={i === 0}>
            <summary>
              <h3>{f.q}</h3>
              <span class="faq__ico" aria-hidden="true"><i class="faq__h" /><i class="faq__v" /></span>
            </summary>
            <p>
              {f.a.split(/(\[fee\])/).map((part) => (part === '[fee]' ? <mark class="ph">[fee]</mark> : part))}
              {f.note && <> <mark class="ph">{f.note}</mark></>}
            </p>
          </details>
        ))
      }
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</section>

<style>
  .faq {
    background: var(--c-cream-2);
    padding: var(--section-y) var(--gutter);
  }
  .faq__grid {
    max-width: var(--max-w);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: 48px clamp(40px, 6vw, 96px);
    align-items: start;
  }
  .faq__list {
    border-top: 1.5px solid var(--c-ink);
  }
  details {
    border-bottom: 1px solid var(--c-hairline-2);
  }
  summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 24px 0;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover h3 {
    color: var(--c-green-600);
  }
  summary h3 {
    margin: 0;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 21px;
    line-height: 1.3;
  }
  .faq__ico {
    position: relative;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1.5px solid var(--c-green-900);
    color: var(--c-ink);
    transition:
      background-color 200ms ease,
      color 200ms ease;
  }
  .faq__ico i {
    position: absolute;
    left: 50%;
    top: 50%;
    background: currentColor;
    transform: translate(-50%, -50%);
  }
  .faq__h {
    width: 14px;
    height: 2px;
  }
  .faq__v {
    width: 2px;
    height: 14px;
  }
  details[open] .faq__ico {
    background: var(--c-green-900);
    color: var(--c-gold);
  }
  details[open] .faq__v {
    display: none;
  }
  details p {
    margin: 0;
    padding: 0 60px 28px 0;
    font-size: 16px;
    line-height: 1.75;
    color: var(--c-ink-soft);
    text-wrap: pretty;
  }
</style>
