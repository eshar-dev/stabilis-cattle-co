---
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import { photo } from '../../data/store';
---

<section id="open-now" class="between">
  <div class="between__grid">
    <div class="between__media" data-reveal>
      <Image src={photo('photo-1618539640243-a9e6572a7fe7')} alt="The last Akaushi animal, now fully spoken for" widths={[700, 1100]} sizes="(min-width: 900px) 45vw, 100vw" />
      <span>Every cut claimed</span>
    </div>
    <div class="stack" style="gap:24px" data-reveal>
      <div class="kicker">Between animals</div>
      <h2 class="h2">Our latest animal is fully spoken for</h2>
      <p class="lede" style="font-size:17px;line-height:1.7">
        Thank you to everyone who ordered. Every cut has been claimed and those orders are being prepared for delivery. The next animal will be up before long. Leave your email below and we will let you know the moment it opens.
      </p>
      <a class="btn btn--primary" href="#signup" style="align-self:flex-start">Tell me when the next one opens<Icon name="arrow-down" /></a>
    </div>
  </div>
</section>

<style>
  .between {
    background: var(--c-white);
  }
  .between__grid {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: var(--section-y) var(--gutter);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: 56px clamp(40px, 6vw, 96px);
    align-items: center;
  }
  .between__media {
    position: relative;
    border-radius: var(--r-xl);
    overflow: hidden;
    aspect-ratio: 5 / 4;
  }
  .between__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.8);
  }
  .between__media span {
    position: absolute;
    left: 20px;
    bottom: 20px;
    background: var(--c-red);
    color: var(--c-cream);
    font-weight: 600;
    font-size: var(--fs-kicker);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 10px 14px;
    border-radius: var(--r-sm);
  }
</style>

